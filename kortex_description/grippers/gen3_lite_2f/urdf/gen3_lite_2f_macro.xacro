<?xml version="1.0"?>
<robot name="gen3_lite_2f_gripper" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="load_gripper" params="
    parent
    prefix
    com_port
    use_fake_hardware:=false
    fake_sensor_commands:=false
    sim_gazebo:=false
    sim_isaac:=false
    isaac_joint_commands:=/isaac_joint_commands
    isaac_joint_states:=/isaac_joint_states
    use_internal_bus_gripper_comm:=true
    moveit_active:=false">

    <!-- ========================================== -->
    <!-- 1. DEFINIÇÃO DE CONTEXTO E PROPRIEDADES    -->
    <!-- ========================================== -->
    <xacro:property name="is_sim" value="${(use_fake_hardware or sim_isaac or sim_gazebo) and not moveit_active}"/>
    <xacro:property name="is_real" value="${not (use_fake_hardware or sim_isaac or sim_gazebo) and not moveit_active}"/>

    <!-- Parâmetros para ambiente MoveIt -->
    <xacro:if value="${moveit_active}">
      <xacro:property name="pfx" value=""/>
      <xacro:property name="prnt" value="dummy_link"/>
      <xacro:property name="mesh_url" value="package://kortex_description/grippers/gen3_lite_2f/meshes/"/>

      <!-- Limites das juntas no MoveIt -->
      <xacro:property name="rfb_rpy" value="0 1.5708 0"/>
      <xacro:property name="rfb_lower" value="0.0"/> <xacro:property name="rfb_upper" value="0.96"/>
      <xacro:property name="rfb_eff" value="1000"/>  <xacro:property name="rfb_vel" value="0.6"/>

      <xacro:property name="lfb_rpy" value="0 1.5708 0"/>
      <xacro:property name="lfb_lower" value="-0.96"/> <xacro:property name="lfb_upper" value="0.0"/>
      <xacro:property name="lfb_eff" value="1000"/>  <xacro:property name="lfb_vel" value="1000"/>
      
      <xacro:property name="lfb_mimic_m" value="-1.0"/> <xacro:property name="lfb_mimic_o" value="0.0"/>
      <xacro:property name="tip_mimic_m" value="-0.676"/> <xacro:property name="tip_mimic_o" value="0.149"/>
    </xacro:if>

    <!-- Parâmetros para simulação ou hardware real -->
    <xacro:unless value="${moveit_active}">
      <xacro:property name="pfx" value="${prefix}"/>
      <xacro:property name="prnt" value="${parent}"/>
      <xacro:property name="mesh_url" value="file://$(find kortex_description)/grippers/gen3_lite_2f/meshes/"/>

      <xacro:property name="rfb_rpy" value="1.571 0.611 1.571"/>
      <xacro:property name="lfb_rpy" value="-1.571 0.611 -1.571"/>
      
      <xacro:property name="lfb_mimic_m" value="1.0"/> <xacro:property name="lfb_mimic_o" value="0.0"/>
      <xacro:property name="tip_mimic_m" value="-0.276"/> <xacro:property name="tip_mimic_o" value="-0.1"/>

      <!-- SIMULAÇÃO -->
      <xacro:if value="${is_sim}">
        <xacro:property name="rfb_lower" value="-0.1"/> <xacro:property name="rfb_upper" value="0.96"/>
        <xacro:property name="rfb_eff" value="10"/>    <xacro:property name="rfb_vel" value="0.6"/>

        <xacro:property name="lfb_lower" value="-0.1"/> <xacro:property name="lfb_upper" value="0.96"/>
        <xacro:property name="lfb_eff" value="10"/>    <xacro:property name="lfb_vel" value="0.6"/>
      </xacro:if>

      <!-- HARDWARE REAL -->
      <xacro:if value="${is_real}">
        <!-- TODO(MarqRazz) look into why the joint and limits needed to be flipped and modified -->
        <xacro:property name="rfb_lower" value="0.0"/>  <xacro:property name="rfb_upper" value="0.85"/>
        <xacro:property name="rfb_eff" value="50"/>     <xacro:property name="rfb_vel" value="0.6"/>

        <xacro:property name="lfb_lower" value="0.0"/>  <xacro:property name="lfb_upper" value="0.85"/>
        <xacro:property name="lfb_eff" value="1000"/>   <xacro:property name="lfb_vel" value="1000"/>
      </xacro:if>
    </xacro:unless>


    <!-- ========================================== -->
    <!-- 2. ROS2 CONTROL (APENAS SIMULAÇÃO)         -->
    <!-- ========================================== -->
    <xacro:if value="${is_sim}">
      <xacro:include filename="$(find kortex_description)/grippers/gen3_lite_2f/urdf/gen3_lite_2f.ros2_control.xacro" />
      <xacro:if value="${sim_gazebo}">
        <xacro:property name="ros2_control_name" value="GazeboSimSystem"/>
      </xacro:if>
      <xacro:if value="${use_fake_hardware}">
        <xacro:property name="ros2_control_name" value="GenericSystem"/>
      </xacro:if>
      <xacro:unless value="${use_fake_hardware or sim_gazebo}">
        <xacro:property name="ros2_control_name" value="${prefix}KortexMultiInterfaceHardware"/>
      </xacro:unless>

      <xacro:gripper_ros2_control
        prefix="${prefix}" use_fake_hardware="${use_fake_hardware}" fake_sensor_commands="${fake_sensor_commands}"
        sim_gazebo="${sim_gazebo}" sim_isaac="${sim_isaac}" isaac_joint_commands="${isaac_joint_commands}"
        isaac_joint_states="${isaac_joint_states}" tf_prefix=""/>
    </xacro:if>


    <!-- ========================================== -->
    <!-- 3. MACRO DE GEOMETRIA (DRY)                -->
    <!-- ========================================== -->
    <xacro:macro name="gripper_mesh" params="mesh_name color_rgba">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_url}${mesh_name}.STL" /></geometry>
        <material name=""><color rgba="${color_rgba}" /></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_url}${mesh_name}.stl" /></geometry>
      </collision>
    </xacro:macro>


    <!-- ========================================== -->
    <!-- 4. ESTRUTURA MECÂNICA UNIFICADA            -->
    <!-- ========================================== -->

    <!-- Tool frame -->
    <link name="${pfx}tool_frame"/>
    <joint name="${pfx}tool_frame_joint" type="fixed">
        <origin xyz="0 0 0.130" rpy="0 0 1.57079632679" />
        <parent link="${prnt}" />
        <child link="${pfx}tool_frame" />
        <axis xyz="0 0 0" />
    </joint>

    <!-- Gripper Base -->
    <joint name="${pfx}gripper_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prnt}" />
      <child link="${pfx}gripper_base_link" />
      <axis xyz="0 0 0" />
    </joint>
    <link name="${pfx}gripper_base_link">
      <inertial>
        <origin xyz="4.03E-06 1.08E-05 0.041397" rpy="0 0 0" />
        <mass value="0.1395" />
        <inertia ixx="0.00011614" ixy="1E-08" ixz="4E-08" iyy="0.00010327" iyz="0" izz="9.707E-05" />
      </inertial>
      <xacro:gripper_mesh mesh_name="gripper_base_link" color_rgba="0.803 0.824 0.820 1" />
    </link>
    <gazebo reference="${pfx}gripper_base_link"><material>Kortex/Gray</material></gazebo>

    <!-- Right Finger Prox -->
    <link name="${pfx}right_finger_prox_link">
      <inertial>
        <origin xyz="0.020257 0.0063483 6.991E-05" rpy="0 0 0" />
        <mass value="0.018385" />
        <inertia ixx="2.29E-06" ixy="1.43E-06" ixz="0" iyy="4.56E-06" iyz="0" izz="4.77E-06" />
      </inertial>
      <xacro:gripper_mesh mesh_name="right_finger_prox_link" color_rgba="0.803 0.824 0.820 1" />
    </link>
    <gazebo reference="${pfx}right_finger_prox_link"><material>Kortex/Gray</material></gazebo>
    
    <joint name="${pfx}right_finger_bottom_joint" type="revolute">
      <origin xyz="0 -0.030501 0.070003" rpy="${rfb_rpy}" />
      <parent link="${pfx}gripper_base_link" />
      <child link="${pfx}right_finger_prox_link" />
      <axis xyz="0 0 ${'-1' if not moveit_active else '1'}" />
      <limit lower="${rfb_lower}" upper="${rfb_upper}" effort="${rfb_eff}" velocity="${rfb_vel}" />
      <xacro:if value="${is_sim}"><dynamics damping="0.1" friction="1"/></xacro:if>
    </joint>

    <!-- Right Finger Dist -->
    <link name="${pfx}right_finger_dist_link">
      <inertial>
        <origin xyz="0.018488 0.0011091 0" rpy="0 0 0" />
        <mass value="0.010748" />
        <inertia ixx="6.3E-07" ixy="3.2E-07" ixz="0" iyy="1.83E-06" iyz="0" izz="1.61E-06" />
      </inertial>
      <xacro:gripper_mesh mesh_name="right_finger_dist_link" color_rgba="0 0.055 0.525 1" />
    </link>
    <gazebo reference="${pfx}right_finger_dist_link"><material>Kortex/Blue</material></gazebo>
    
    <joint name="${pfx}right_finger_tip_joint" type="revolute">
      <origin xyz="-0.045636 0.020423 0" rpy="0 0 0" />
      <parent link="${pfx}right_finger_prox_link" />
      <child link="${pfx}right_finger_dist_link" />
      <axis xyz="0 0 1" />
      <limit lower="-0.50" upper="0.21" effort="1000" velocity="1000" />
      <mimic joint="${pfx}right_finger_bottom_joint" multiplier="${tip_mimic_m}" offset="${tip_mimic_o}" />
    </joint>

    <!-- Left Finger Prox -->
    <link name="${pfx}left_finger_prox_link">
      <inertial>
        <origin xyz="0.020257 0.0063483 6.99E-05" rpy="0 0 0" />
        <mass value="0.018385" />
        <inertia ixx="2.29E-06" ixy="1.43E-06" ixz="0" iyy="4.56E-06" iyz="0" izz="4.77E-06" />
      </inertial>
      <xacro:gripper_mesh mesh_name="left_finger_prox_link" color_rgba="0.803 0.824 0.820 1" />
    </link>
    <gazebo reference="${pfx}left_finger_prox_link"><material>Kortex/Gray</material></gazebo>
    
    <joint name="${pfx}left_finger_bottom_joint" type="revolute">
      <origin xyz="0 0.0305 0.070003" rpy="${lfb_rpy}" />
      <parent link="${pfx}gripper_base_link" />
      <child link="${pfx}left_finger_prox_link" />
      <axis xyz="0 0 1" />
      <limit lower="${lfb_lower}" upper="${lfb_upper}" effort="${lfb_eff}" velocity="${lfb_vel}" />
      <xacro:if value="${is_sim}"><dynamics damping="0.1" friction="1"/></xacro:if>
      <mimic joint="${pfx}right_finger_bottom_joint" multiplier="${lfb_mimic_m}" offset="${lfb_mimic_o}" />
    </joint>

    <!-- Left Finger Dist -->
    <link name="${pfx}left_finger_dist_link">
      <inertial>
        <origin xyz="-0.018488 0.0011091 0" rpy="0 0 0" />
        <mass value="0.010748" />
        <inertia ixx="6.3E-07" ixy="3.2E-07" ixz="0" iyy="1.83E-06" iyz="0" izz="1.61E-06" />
      </inertial>
      <xacro:gripper_mesh mesh_name="left_finger_dist_link" color_rgba="0 0.055 0.525 1" />
    </link>
    <gazebo reference="${pfx}left_finger_dist_link"><material>Kortex/Blue</material></gazebo>
    
    <joint name="${pfx}left_finger_tip_joint" type="revolute">
      <origin xyz="-0.045636 -0.020423 6.9901E-05" rpy="0 0 0" />
      <parent link="${pfx}left_finger_prox_link" />
      <child link="${pfx}left_finger_dist_link" />
      <axis xyz="0 0 -1" />
      <limit lower="-0.50" upper="0.21" effort="1000" velocity="1000" />
      <mimic joint="${pfx}right_finger_bottom_joint" multiplier="${tip_mimic_m}" offset="${tip_mimic_o}" />
    </joint>

  </xacro:macro>
</robot>